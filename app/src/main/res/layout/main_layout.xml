<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF14171A"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current status"
        android:textColor="#FF90A4AE"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/sb_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textSize="19sp"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/sb_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="11sp"
        android:textColor="#FF78909C" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#FF2B3238" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set"
        android:textColor="#FF90A4AE"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/sb_states"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="For how long"
        android:textColor="#FF90A4AE"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/sb_durations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <Button
        android:id="@+id/sb_clear"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="#FF37474F"
        android:text="Clear - back to available"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="11sp"
        android:textColor="#FF78909C"
        android:lineSpacingMultiplier="1.15"
        android:text="Teammates do not need this plugin. Your marker changes colour and carries a line of text saying why and for how long, which any TAK client shows.\n\nA status clears itself when the timer runs out, and when ATAK closes. A forgotten status is worse than none - the team routes around somebody who is actually available." />

    <TextView
        android:id="@+id/sb_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="10sp"
        android:textColor="#FF546E7A" />

</LinearLayout>
