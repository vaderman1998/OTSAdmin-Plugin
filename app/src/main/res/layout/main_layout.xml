<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF14171A"
    android:padding="10dp">

    <!-- Connection. First, because nothing below it works until this says
         Connected, and the reason it does not is the most useful line here. -->
    <TextView
        android:id="@+id/ots_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not configured"
        android:textColor="#FFFFB74D"
        android:textSize="13sp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/ots_roles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF90A4AE"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/ots_connect"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ots_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Server"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF2E3A42" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open a section"
        android:textColor="#FF90A4AE"
        android:textSize="11sp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- One full-width button per section, each opening its own page.
         Filled in code from OtsSection, so adding a view is one line there
         and nothing here. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ots_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
