<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="OpenTAKServer">

        <com.atakmap.android.gui.PanEditTextPreference
            android:key="pref_ots_url"
            android:title="@string/pref_server_title"
            android:summary="@string/pref_server_summary"
            android:inputType="textUri"
            android:defaultValue="" />

        <com.atakmap.android.gui.PanEditTextPreference
            android:key="pref_ots_username"
            android:title="@string/pref_username_title"
            android:summary="@string/pref_username_summary"
            android:inputType="text"
            android:defaultValue="" />

        <com.atakmap.android.gui.PanEditTextPreference
            android:key="pref_ots_password"
            android:title="@string/pref_password_title"
            android:summary="@string/pref_password_summary"
            android:inputType="textPassword"
            android:defaultValue="" />

    </PreferenceCategory>

</PreferenceScreen>
